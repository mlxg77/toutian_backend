# =====================================
# 环境变量配置模板（提交到 Git，作为团队参考）
# =====================================
# 使用方法：复制一份为 .env，填入你自己的配置
#   cp .env.example .env
#   vi .env
# =====================================

# ---- MySQL ----
# 格式：mysql+aiomysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# 注意：密码里的特殊字符（@ : / # ?）要 URL 编码
#       @ → %40    : → %3A    / → %2F    # → %23    ? → %3F
#
# Docker 部署（后端在容器里）：主机填 host.docker.internal
# 本地开发（后端直接 uvicorn 跑）：主机填 localhost 或 127.0.0.1
DATABASE_URL=mysql+aiomysql://root:YourPassword%40Here@host.docker.internal:3306/news_app?charset=utf8mb4

# ---- Redis ----
# Docker 部署：主机填 redis（docker-compose 的服务名）
# 本地开发：主机填 localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- 日志/调试 ----
SQL_ECHO=false
